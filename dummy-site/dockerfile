# ---- build ----------------------------------------------------------------
FROM node:22-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# ---- serve ----------------------------------------------------------------
# nginx-unprivileged runs as uid 101 and never needs root, which is what lets
# the container run read-only with every capability dropped.
FROM nginxinc/nginx-unprivileged:1.27-alpine

ARG GIT_SHA=dev
ARG GIT_REF=local
ARG BUILD_TIME=unknown

USER root
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

RUN printf '{"sha":"%s","ref":"%s","built":"%s"}\n' \
      "$GIT_SHA" "$GIT_REF" "$BUILD_TIME" \
      > /usr/share/nginx/html/build.json \
 && chown -R nginx:nginx /usr/share/nginx/html
USER nginx

EXPOSE 8080
