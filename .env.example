# Copy to .env for local work. .env is gitignored — keep it that way.
# In CI these come from the GitHub environment the branch selects:
#   main -> production, dev -> development
#
# ---- public: GitHub *variables* -------------------------------------------
# Vite inlines these into the client bundle, so they are published the moment
# the site is live. That is by design; they are not secrets.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_PAYMENTS_CLIENT_TOKEN=pk_test_...

# the server reads the same two values without the VITE_ prefix
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---- secret: GitHub *secrets* ---------------------------------------------
# Server-side only. Never pass these as build args: build arguments are
# recoverable from image layers with `docker history`.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security entirely — it is full
# read and write access to the database.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
RESEND_API_KEY=re_...

# Whoever holds this can run a connector and receive traffic for your hostname.
TUNNEL_TOKEN=eyJhIjoi...

PORT=4000
